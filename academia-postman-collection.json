{
	"info": {
		"_postman_id": "academia-distribuida-apis-v2",
		"name": "Academia - Sistema Distribuído (V2 com Verbos & JWT)",
		"description": "Coleção de endpoints REST do API Gateway (Porta 8080) com autenticação JWT (Aula 7), todas as rotas iniciando por verbos, Swagger integrado e chamadas gRPC internas para os 3 microsserviços.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwtToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "0. Autenticação (JWT)",
			"item": [
				{
					"name": "Realizar Login / Autenticar",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"aluno\",\n  \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/autenticar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "autenticar"]
						},
						"description": "Gera e retorna o token JWT assinado com HS256 (30 minutos de validade). Copie o token retornado para a variável {{jwtToken}}."
					}
				},
				{
					"name": "Gerar Token Rápido de Laboratório",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/gerar-token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerar-token"]
						},
						"description": "Emite instantaneamente um token JWT de demonstração."
					}
				}
			]
		},
		{
			"name": "1. Gestão de Alunos",
			"item": [
				{
					"name": "Cadastrar Aluno",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Carlos Silva\",\n  \"cpf\": \"123.456.789-00\",\n  \"email\": \"carlos.silva@email.com\",\n  \"telefone\": \"(11) 98765-4321\",\n  \"peso\": 82.5,\n  \"altura\": 1.78\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/cadastrar-aluno",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cadastrar-aluno"]
						}
					}
				},
				{
					"name": "Listar Alunos",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listar-alunos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listar-alunos"]
						}
					}
				},
				{
					"name": "Buscar Aluno por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscar-aluno/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscar-aluno", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Atualizar Status do Aluno",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ATIVO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/atualizar-status-aluno/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "atualizar-status-aluno", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Fichas de Treino & IA",
			"item": [
				{
					"name": "Criar Ficha Manual",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"titulo\": \"Treino A — Peito e Tríceps\",\n  \"objetivo\": \"HIPERTROFIA\",\n  \"itens\": [\n    {\n      \"nomeExercicio\": \"Supino Reto\",\n      \"grupoMuscular\": \"Peito\",\n      \"series\": 4,\n      \"repeticoes\": 10,\n      \"cargaSugerida\": 30.0\n    },\n    {\n      \"nomeExercicio\": \"Tríceps Corda\",\n      \"grupoMuscular\": \"Tríceps\",\n      \"series\": 3,\n      \"repeticoes\": 12,\n      \"cargaSugerida\": 15.0\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/criar-ficha-treino",
							"host": ["{{baseUrl}}"],
							"path": ["api", "criar-ficha-treino"]
						}
					}
				},
				{
					"name": "Gerar Treino com IA",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"objetivo\": \"HIPERTROFIA\",\n  \"nivel\": \"INTERMEDIARIO\",\n  \"focoMuscular\": \"Peito e Tríceps\",\n  \"observacoes\": \"Foco em hipertrofia miofibrilar\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/gerar-treino-ia",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerar-treino-ia"]
						}
					}
				},
				{
					"name": "Buscar Ficha por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscar-ficha-treino/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscar-ficha-treino", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_FICHA" }
							]
						}
					}
				},
				{
					"name": "Listar Fichas por Aluno",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listar-fichas-aluno/:alunoId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listar-fichas-aluno", ":alunoId"],
							"variable": [
								{ "key": "alunoId", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Registrar Execução (Cargas Reais)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": [\n    {\n      \"itemId\": \"UUID_DO_ITEM_1\",\n      \"cargaUsada\": 35.0,\n      \"concluido\": true\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/registrar-execucao-treino/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "registrar-execucao-treino", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_FICHA" }
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Gestão Financeira",
			"item": [
				{
					"name": "Gerar Mensalidade",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"valor\": 119.90,\n  \"dataVencimento\": \"2026-11-15\",\n  \"descricao\": \"Mensalidade Novembro/2026\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/gerar-mensalidade",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerar-mensalidade"]
						}
					}
				},
				{
					"name": "Buscar Mensalidade por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscar-mensalidade/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscar-mensalidade", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_MENSALIDADE" }
							]
						}
					}
				},
				{
					"name": "Listar Mensalidades por Aluno",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listar-mensalidades-aluno/:alunoId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listar-mensalidades-aluno", ":alunoId"],
							"variable": [
								{ "key": "alunoId", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Registrar Pagamento",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"formaPagamento\": \"PIX\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/registrar-pagamento-mensalidade/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "registrar-pagamento-mensalidade", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_MENSALIDADE" }
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "jwtToken",
			"value": ""
		}
	]
}
