{
	"info": {
		"_postman_id": "gymflow-pro-apis-v2",
		"name": "GymFlow Pro — Sistema Distribuído (API Gateway + Microsserviços gRPC)",
		"description": "Coleção de endpoints REST do API Gateway (Porta 8080) com autenticação JWT, rotas em camelCase, Swagger integrado e chamadas gRPC internas para os 3 microsserviços (aluno-service, treino-service, financeiro-service).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwtToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "0. Autenticação (JWT)",
			"item": [
				{
					"name": "Realizar Login / Autenticar",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('jwtToken', json.token);",
									"        console.log('Token JWT capturado automaticamente!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"aluno\",\n  \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/autenticar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "autenticar"]
						},
						"description": "Gera e retorna o token JWT assinado com HS256 (30 minutos de validade). O token é capturado automaticamente para a variável {{jwtToken}}."
					}
				},
				{
					"name": "Gerar Token Rápido de Laboratório",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.token) {",
									"        pm.collectionVariables.set('jwtToken', json.token);",
									"        console.log('Token JWT capturado automaticamente!');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/gerarToken",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerarToken"]
						},
						"description": "Emite instantaneamente um token JWT de demonstração."
					}
				}
			]
		},
		{
			"name": "1. Gestão de Alunos",
			"item": [
				{
					"name": "Cadastrar Aluno",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Carlos Silva\",\n  \"cpf\": \"123.456.789-00\",\n  \"email\": \"carlos.silva@email.com\",\n  \"telefone\": \"(11) 98765-4321\",\n  \"peso\": 82.5,\n  \"altura\": 1.78\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/cadastrarAluno",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cadastrarAluno"]
						}
					}
				},
				{
					"name": "Listar Alunos",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listarAlunos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listarAlunos"]
						}
					}
				},
				{
					"name": "Buscar Aluno por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscarAluno/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscarAluno", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Atualizar Status do Aluno",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ATIVO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/atualizarStatusAluno/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "atualizarStatusAluno", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Fichas de Treino & IA",
			"item": [
				{
					"name": "Criar Ficha Manual",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"titulo\": \"Treino A — Peito e Tríceps\",\n  \"objetivo\": \"HIPERTROFIA\",\n  \"itens\": [\n    {\n      \"nomeExercicio\": \"Supino Reto\",\n      \"grupoMuscular\": \"Peito\",\n      \"series\": 4,\n      \"repeticoes\": 10,\n      \"cargaSugerida\": 30.0\n    },\n    {\n      \"nomeExercicio\": \"Tríceps Corda\",\n      \"grupoMuscular\": \"Tríceps\",\n      \"series\": 3,\n      \"repeticoes\": 12,\n      \"cargaSugerida\": 15.0\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/criarFichaTreino",
							"host": ["{{baseUrl}}"],
							"path": ["api", "criarFichaTreino"]
						}
					}
				},
				{
					"name": "Gerar Treino com IA",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"objetivo\": \"HIPERTROFIA\",\n  \"nivel\": \"INTERMEDIARIO\",\n  \"focoMuscular\": \"Peito e Tríceps\",\n  \"observacoes\": \"Foco em hipertrofia miofibrilar\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/gerarTreinoIa",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerarTreinoIa"]
						}
					}
				},
				{
					"name": "Buscar Ficha por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscarFichaTreino/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscarFichaTreino", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_FICHA" }
							]
						}
					}
				},
				{
					"name": "Listar Fichas por Aluno",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listarFichasAluno/:alunoId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listarFichasAluno", ":alunoId"],
							"variable": [
								{ "key": "alunoId", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Registrar Execução (Cargas Reais)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": [\n    {\n      \"itemId\": \"UUID_DO_ITEM_1\",\n      \"cargaUsada\": 35.0,\n      \"concluido\": true\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/registrarExecucaoTreino/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "registrarExecucaoTreino", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_FICHA" }
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Gestão Financeira",
			"item": [
				{
					"name": "Gerar Mensalidade",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"valor\": 119.90,\n  \"dataVencimento\": \"2026-11-15\",\n  \"descricao\": \"Mensalidade Novembro/2026\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/gerarMensalidade",
							"host": ["{{baseUrl}}"],
							"path": ["api", "gerarMensalidade"]
						}
					}
				},
				{
					"name": "Buscar Mensalidade por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/buscarMensalidade/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "buscarMensalidade", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_MENSALIDADE" }
							]
						}
					}
				},
				{
					"name": "Listar Mensalidades por Aluno",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/listarMensalidadesAluno/:alunoId",
							"host": ["{{baseUrl}}"],
							"path": ["api", "listarMensalidadesAluno", ":alunoId"],
							"variable": [
								{ "key": "alunoId", "value": "UUID_DO_ALUNO" }
							]
						}
					}
				},
				{
					"name": "Registrar Pagamento",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"formaPagamento\": \"PIX\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/registrarPagamentoMensalidade/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "registrarPagamentoMensalidade", ":id"],
							"variable": [
								{ "key": "id", "value": "UUID_DA_MENSALIDADE" }
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "jwtToken",
			"value": ""
		}
	]
}
