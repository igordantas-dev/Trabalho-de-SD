						"description": "Busca detalhes da ficha de treino e seus itens."
					}
				},
				{
					"name": "Listar Fichas por Aluno",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/treinos/aluno/:alunoId",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"treinos",
								"aluno",
								":alunoId"
							],
							"variable": [
								{
									"key": "alunoId",
									"value": "UUID_DO_ALUNO"
								}
							]
						},
						"description": "Lista todas as fichas de treino vinculadas a um aluno."
					}
				},
				{
					"name": "Registrar Execução do Treino (Cargas Reais)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"itens\": [\n    {\n      \"itemId\": \"UUID_DO_ITEM_1\",\n      \"cargaUsada\": 35.0,\n      \"concluido\": true\n    },\n    {\n      \"itemId\": \"UUID_DO_ITEM_2\",\n      \"cargaUsada\": 17.5,\n      \"concluido\": true\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/treinos/:id/execucao",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"treinos",
								":id",
								"execucao"
							],
							"variable": [
								{
									"key": "id",
									"value": "UUID_DA_FICHA"
								}
							]
						},
						"description": "Registra a conclusão do treino e salva as cargas reais utilizadas em cada exercício."
					}
				}
			]
		},
