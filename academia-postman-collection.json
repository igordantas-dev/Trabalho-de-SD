	"item": [
		{
			"name": "1. Alunos",
			"item": [
				{
					"name": "Cadastrar Aluno",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Carlos Silva\",\n  \"cpf\": \"123.456.789-00\",\n  \"email\": \"carlos.silva@email.com\",\n  \"telefone\": \"(11) 98765-4321\",\n  \"peso\": 82.5,\n  \"altura\": 1.78\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/alunos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alunos"
							]
						},
						"description": "Cadastra um novo aluno no PostgreSQL via AlunoService (gRPC :9091)."
					}
				},
				{
					"name": "Listar Alunos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/alunos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alunos"
							]
						},
						"description": "Lista todos os alunos cadastrados."
					}
				},
				{
					"name": "Buscar Aluno por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/alunos/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alunos",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "UUID_DO_ALUNO",
									"description": "UUID do aluno"
								}
							]
						},
						"description": "Busca detalhes de um aluno pelo UUID."
					}
				},
				{
					"name": "Atualizar Status do Aluno",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"ATIVO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/alunos/:id/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"alunos",
								":id",
								"status"
							],
							"variable": [
								{
									"key": "id",
									"value": "UUID_DO_ALUNO"
								}
							]
						},
						"description": "Atualiza o status de matrícula (ATIVO, INATIVO, INADIMPLENTE)."
					}
				}
			]
		},
		{
			"name": "2. Treinos",
			"item": [
				{
					"name": "Criar Ficha de Treino",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"alunoId\": \"UUID_DO_ALUNO\",\n  \"titulo\": \"Treino A - Peito e Tríceps\",\n  \"objetivo\": \"HIPERTROFIA\",\n  \"itens\": [\n    {\n      \"nomeExercicio\": \"Supino Reto\",\n      \"grupoMuscular\": \"Peito\",\n      \"series\": 4,\n      \"repeticoes\": 10,\n      \"cargaSugerida\": 30.0\n    },\n    {\n      \"nomeExercicio\": \"Tríceps Corda\",\n      \"grupoMuscular\": \"Tríceps\",\n      \"series\": 3,\n      \"repeticoes\": 12,\n      \"cargaSugerida\": 15.0\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/treinos",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"treinos"
							]
						},
						"description": "Cria uma ficha de treino com exercícios para um aluno via TreinoService (gRPC :9092)."
					}
				},
				{
					"name": "Buscar Ficha por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/treinos/:id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"treinos",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "UUID_DA_FICHA"
								}
